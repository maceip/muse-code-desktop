{
  "manifest_version": 3,
  "name": "Muse on Safari",
  "description": "Let Muse code drive Safari.",
  "version": "1.5.1",

  "icons": {
    "16": "images/icon-idle-16.png",
    "32": "images/icon-idle-32.png",
    "64": "images/icon-idle-64.png",
    "128": "images/icon-idle-128.png",
    "512": "images/icon.svg"
  },

  "options_ui": {
    "page": "options.html"
  },

  "action": {
    "default_title": "Muse on Safari",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-idle-16.png",
      "32": "images/icon-idle-32.png",
      "64": "images/icon-idle-64.png",
      "128": "images/icon-idle-128.png"
    }
  },

  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>",
    "*://*/*"
  ],

  "background": {
    "scripts": [ "background.js" ],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [ "<all_urls>", "*://*/*" ],
      "js": [ "content.js" ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
