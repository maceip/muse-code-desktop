{
  "manifest_version": 3,
  "name": "Muse Safari Bridge",
  "description": "Persistent JavaScript DOM & tab control bridge allowing the Muse coding agent to own a Safari tab, navigate pages, fill forms, and inspect the DOM.",
  "version": "1.5.1",

  "icons": {
    "512": "images/icon.svg"
  },

  "options_ui": {
    "page": "options.html"
  },

  "action": {
    "default_title": "Muse Safari Bridge",
    "default_popup": "popup.html",
    "default_icon": "images/icon.svg"
  },

  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>",
    "*://*/*"
  ],

  "background": {
    "scripts": [ "background.js" ],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [ "<all_urls>", "*://*/*" ],
      "js": [ "content.js" ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
